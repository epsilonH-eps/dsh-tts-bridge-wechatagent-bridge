{
  "name": "dsh-tts-bridge-wechatagent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把朗读桥念出来的声音录成 SILK，并通过微信原生语音消息发到当前微信聊天。",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "wechat",
    "wechatagent",
    "tts",
    "voice",
    "silk"
